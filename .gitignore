# ---------------------------------------------------------------
# PowerMeter .gitignore
# ---------------------------------------------------------------

# ---- Gradle ----
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar

# ---- Android / Kotlin 构建产物 ----
.kotlin/
*.apk
*.aab
*.ap_
*.dex
*.class
app/build/
app/release/
release/
captures/

# ---- 本地配置（含 SDK 绝对路径，禁止入库）----
local.properties

# ---- IDE ----
.idea/
*.iml
*.iws
*.ipr
out/

# ---- 构建 / 排障日志（临时产物）----
build*.log

# ---- 工作区内部数据（含其它项目信息，不入库）----
.workbuddy/

# ---- OS ----
.DS_Store
Thumbs.db
desktop.ini
