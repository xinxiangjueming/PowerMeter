    <string name="option_keep_sampling_on_lock">Keep sampling when locked</string>
    <string name="option_keep_sampling_on_lock_desc">Hold a CPU wake lock so sampling continues after the screen turns off; when disabled the screen-off interval widens to 5s for better battery life</string>

    <string name="option_charge_monitor">Charge power monitor</string>
    <string name="option_charge_monitor_desc">Turns the screen off 5s after sampling starts; when the battery input current stays at 0mA for 30s a CSV is saved automatically (sampling keeps running)</string>

    <string name="option_series_dual_battery">Series dual battery</string>
    <string name="option_series_dual_battery_desc">The kernel reports single-cell voltage; on series packs the whole-pack voltage is ×2 and power follows ×2 (not needed on Xiaomi devices)</string>

